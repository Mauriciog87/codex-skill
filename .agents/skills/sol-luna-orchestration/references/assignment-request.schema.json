{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "lock_id": [
      "generation"
    ],
    "generation": [
      "lock_id"
    ]
  },
  "required": [
    "profile",
    "base_revision",
    "allowed_write_roots",
    "forbidden_write_roots",
    "required_checks",
    "artifacts",
    "review_policy",
    "operator_approval_required"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "explore",
        "implement-lite",
        "playwright",
        "implement",
        "review"
      ]
    },
    "base_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "normal",
        "low"
      ]
    },
    "allowed_write_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_write_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          }
        }
      }
    },
    "review_policy": {
      "type": "string",
      "enum": [
        "root",
        "independent"
      ]
    },
    "operator_approval_required": {
      "type": "boolean"
    },
    "allow_symlinks": {
      "type": "boolean"
    },
    "allow_submodules": {
      "type": "boolean"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "manual",
            "commit",
            "push"
          ]
        },
        "commit_message": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "manual"
              }
            }
          },
          "then": {
            "properties": {
              "commit_message": {
                "type": "null"
              },
              "remote": {
                "type": "null"
              },
              "branch": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "commit"
              }
            }
          },
          "then": {
            "required": [
              "commit_message"
            ],
            "properties": {
              "commit_message": {
                "type": "string"
              },
              "remote": {
                "type": "null"
              },
              "branch": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "push"
              }
            }
          },
          "then": {
            "required": [
              "commit_message",
              "remote",
              "branch"
            ],
            "properties": {
              "commit_message": {
                "type": "string"
              },
              "remote": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "parent_assignment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "review_target_candidate_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "lock_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  }
}
