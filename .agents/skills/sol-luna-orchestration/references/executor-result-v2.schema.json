{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "operator_requests"
        ],
        "properties": {
          "operator_requests": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "changed_files": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "candidate": {
            "type": "object"
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "assignment_id",
    "attempt",
    "status",
    "profile",
    "thread_id",
    "model",
    "reasoning_effort",
    "service_tier",
    "routing_verified",
    "sandbox_mode",
    "base_revision",
    "candidate",
    "summary",
    "changed_files",
    "artifacts",
    "operator_requests",
    "checks",
    "blockers",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "profile": {
      "type": "string",
      "enum": [
        "explore",
        "implement-lite",
        "playwright",
        "implement",
        "review"
      ]
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_tier": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fast",
        "standard",
        null
      ]
    },
    "routing_verified": {
      "type": "boolean"
    },
    "sandbox_mode": {
      "type": "string",
      "enum": [
        "read-only",
        "workspace-write"
      ]
    },
    "base_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "candidate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/candidate"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "operator_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operatorRequest"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/checkEvidence"
          }
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_revision",
        "candidate_ref",
        "base_revision",
        "diff_sha256",
        "contract_sha256",
        "artifact_manifest_sha256",
        "verification_sha256",
        "changed_paths",
        "artifacts",
        "created_at"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "candidate_ref": {
          "type": "string",
          "pattern": "^refs/codex-orchestration/candidates/"
        },
        "base_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "diff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verification_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "kind",
        "sha256",
        "stored_path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stored_path": {
          "type": "string"
        }
      }
    },
    "operatorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "question",
        "choices",
        "assignment_id",
        "attempt",
        "ordinal"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignment_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "stdout",
        "stderr"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
